def edgeCostInt4 (v : Fin 4) (gs : Fin 4 → Fin 4) (ys : Fin 5 → Fin 6) : ℤ :=
  let yv := (ys v.castSucc).val
  let yd := (ys (Fin.last 4)).val
  let dy := if yv ≤ yd then yd - yv else yv - yd
  match v.val with
  | 0 => costFlat4[((((gs 0).val * 4 + (gs 1).val) * 4 + (gs 2).val) * 4 + (gs 3).val) * 6 + dy]!
  | 1 => costFlat3[(((gs 1).val * 4 + (gs 2).val) * 4 + (gs 3).val) * 6 + dy]!
  | 2 => costFlat2[((gs 2).val * 4 + (gs 3).val) * 6 + dy]!
  | _ => costFlat1[(gs 3).val * 6 + dy]!

noncomputable def edgeCost4 (v : Fin 4) (gs : Fin 4 → Fin 4) (ys : Fin 5 → Fin 6) : ℝ :=
  (edgeCostInt4 v gs ys : ℝ) / (costScale : ℝ)

def chosenCostInt4 (ch : List (Fin 4)) (gs : Fin 4 → Fin 4) (ys : Fin 5 → Fin 6) : ℤ :=
  (ch.map fun v => edgeCostInt4 v gs ys).sum

lemma chosenCostInt4_cast (ch : List (Fin 4)) (gs : Fin 4 → Fin 4) (ys : Fin 5 → Fin 6) :
    chosenTableCost edgeCost4 ch gs ys = (chosenCostInt4 ch gs ys : ℝ) / (costScale : ℝ) := by
  induction ch with
  | nil => simp [chosenTableCost, chosenCostInt4]
  | cons v rest ih =>
    unfold chosenTableCost chosenCostInt4 at ih ⊢
    simp only [List.map_cons, List.sum_cons, Int.cast_add, add_div]
    rw [ih, edgeCost4]

def encG (g : Fin 3 → Fin 4) : ℕ := ((g 0).val * 4 + (g 1).val) * 4 + (g 2).val
def encY (y : Fin 4 → Fin 6) : ℕ := (((y 0).val * 6 + (y 1).val) * 6 + (y 2).val) * 6 + (y 3).val
def encZ (z : Window 3 4 6) : ℕ := encG z.1 * 1296 + encY z.2
def encUZ (u : Fin 56) (z : Window 3 4 6) : ℕ := u.val * 82944 + encZ z

lemma encG_lt (g : Fin 3 → Fin 4) : encG g < 64 := by
  unfold encG; have := (g 0).isLt; have := (g 1).isLt; have := (g 2).isLt; omega

lemma encY_lt (y : Fin 4 → Fin 6) : encY y < 1296 := by
  unfold encY; have := (y 0).isLt; have := (y 1).isLt; have := (y 2).isLt; have := (y 3).isLt; omega

lemma encZ_lt (z : Window 3 4 6) : encZ z < 82944 := by
  unfold encZ; have := encG_lt z.1; have := encY_lt z.2; omega

lemma encG_prevWindow (old : Label 4 6) (z' : Window 3 4 6) :
    encG (prevWindow old z').1 = old.1.val * 16 + encG z'.1 / 4 := by
  have h0 : (prevWindow old z').1 0 = old.1 := rfl
  have h1 : (prevWindow old z').1 1 = z'.1 0 := rfl
  have h2 : (prevWindow old z').1 2 = z'.1 1 := rfl
  unfold encG
  rw [h0, h1, h2]
  have a0 := (z'.1 0).isLt; have a1 := (z'.1 1).isLt; have a2 := (z'.1 2).isLt
  omega

lemma encY_prevWindow (old : Label 4 6) (z' : Window 3 4 6) :
    encY (prevWindow old z').2 = old.2.val * 216 + encY z'.2 / 6 := by
  have h0 : (prevWindow old z').2 0 = old.2 := rfl
  have h1 : (prevWindow old z').2 1 = z'.2 0 := rfl
  have h2 : (prevWindow old z').2 2 = z'.2 1 := rfl
  have h3 : (prevWindow old z').2 3 = z'.2 2 := rfl
  unfold encY
  rw [h0, h1, h2, h3]
  have a0 := (z'.2 0).isLt; have a1 := (z'.2 1).isLt; have a2 := (z'.2 2).isLt; have a3 := (z'.2 3).isLt
  omega

@[inline] def edgeCostFlat (v : Fin 4) (gOld yOld gi yi : ℕ) : ℤ :=
  let yd := yi % 6
  match v.val with
  | 0 =>
    let dy := if yOld ≤ yd then yd - yOld else yOld - yd
    costFlat4[(gOld * 64 + gi) * 6 + dy]!
  | 1 =>
    let yv := yi / 216
    let dy := if yv ≤ yd then yd - yv else yv - yd
    costFlat3[gi * 6 + dy]!
  | 2 =>
    let yv := (yi / 36) % 6
    let dy := if yv ≤ yd then yd - yv else yv - yd
    costFlat2[(gi % 16) * 6 + dy]!
  | _ =>
    let yv := (yi / 6) % 6
    let dy := if yv ≤ yd then yd - yv else yv - yd
    costFlat1[(gi % 4) * 6 + dy]!

lemma edgeCostFlat_eq (v : Fin 4) (old : Label 4 6) (z' : Window 3 4 6) :
    edgeCostFlat v old.1.val old.2.val (encG z'.1) (encY z'.2) =
      edgeCostInt4 v (fullGapsOf old z') (fullHeightsOf old z') := by
  have hg0 := (z'.1 0).isLt; have hg1 := (z'.1 1).isLt; have hg2 := (z'.1 2).isLt
  have hy0 := (z'.2 0).isLt; have hy1 := (z'.2 1).isLt; have hy2 := (z'.2 2).isLt; have hy3 := (z'.2 3).isLt
  have g0 : fullGapsOf old z' 0 = old.1 := rfl
  have g1 : fullGapsOf old z' 1 = z'.1 0 := rfl
  have g2 : fullGapsOf old z' 2 = z'.1 1 := rfl
  have g3 : fullGapsOf old z' 3 = z'.1 2 := rfl
  have y0 : fullHeightsOf old z' (0 : Fin 4).castSucc = old.2 := rfl
  have y1 : fullHeightsOf old z' (1 : Fin 4).castSucc = z'.2 0 := rfl
  have y2 : fullHeightsOf old z' (2 : Fin 4).castSucc = z'.2 1 := rfl
  have y3 : fullHeightsOf old z' (3 : Fin 4).castSucc = z'.2 2 := rfl
  have y4 : fullHeightsOf old z' (Fin.last 4) = z'.2 3 := rfl
  have hmod6 : encY z'.2 % 6 = (z'.2 3).val := by unfold encY; omega
  have hdiv216 : encY z'.2 / 216 = (z'.2 0).val := by unfold encY; omega
  have hdiv36 : encY z'.2 / 36 % 6 = (z'.2 1).val := by unfold encY; omega
  have hdiv6 : encY z'.2 / 6 % 6 = (z'.2 2).val := by unfold encY; omega
  have hgmod16 : encG z'.1 % 16 = (z'.1 1).val * 4 + (z'.1 2).val := by unfold encG; omega
  have hgmod4 : encG z'.1 % 4 = (z'.1 2).val := by unfold encG; omega
  fin_cases v
  · dsimp only [edgeCostFlat, edgeCostInt4]
    have hy0' : fullHeightsOf old z' (⟨0, by decide⟩ : Fin 4).castSucc = old.2 := rfl
    rw [g0, g1, g2, g3, y4, hmod6]
    change costFlat4[(old.1.val * 64 + encG z'.1) * 6 + _]! =
      costFlat4[(((old.1.val * 4 + (z'.1 0).val) * 4 + (z'.1 1).val) * 4 + (z'.1 2).val) * 6 +
        if old.2.val ≤ (z'.2 3).val then (z'.2 3).val - old.2.val else old.2.val - (z'.2 3).val]!
    congr 1; unfold encG; omega
  · dsimp only [edgeCostFlat, edgeCostInt4]
    rw [g1, g2, g3, y4, hmod6, hdiv216]
    change costFlat3[encG z'.1 * 6 + _]! =
      costFlat3[(((z'.1 0).val * 4 + (z'.1 1).val) * 4 + (z'.1 2).val) * 6 +
        if (z'.2 0).val ≤ (z'.2 3).val then (z'.2 3).val - (z'.2 0).val else (z'.2 0).val - (z'.2 3).val]!
    rfl
  · dsimp only [edgeCostFlat, edgeCostInt4]
    rw [g2, g3, y4, hmod6, hdiv36, hgmod16]
    change costFlat2[((z'.1 1).val * 4 + (z'.1 2).val) * 6 + _]! =
      costFlat2[((z'.1 1).val * 4 + (z'.1 2).val) * 6 +
        if (z'.2 1).val ≤ (z'.2 3).val then (z'.2 3).val - (z'.2 1).val else (z'.2 1).val - (z'.2 3).val]!
    rfl
  · dsimp only [edgeCostFlat, edgeCostInt4]
    rw [g3, y4, hmod6, hdiv6, hgmod4]
    change costFlat1[(z'.1 2).val * 6 + _]! =
      costFlat1[(z'.1 2).val * 6 +
        if (z'.2 2).val ≤ (z'.2 3).val then (z'.2 3).val - (z'.2 2).val else (z'.2 2).val - (z'.2 3).val]!
    rfl

@[inline] def chosenCostFlat (ch : List (Fin 4)) (gOld yOld gi yi : ℕ) : ℤ :=
  match ch with
  | [] => 0
  | [v] => edgeCostFlat v gOld yOld gi yi
  | [v1, v2] => edgeCostFlat v1 gOld yOld gi yi + edgeCostFlat v2 gOld yOld gi yi
  | _ => (ch.map fun v => edgeCostFlat v gOld yOld gi yi).sum

lemma chosenCostFlat_eq (ch : List (Fin 4)) (old : Label 4 6) (z' : Window 3 4 6) :
    chosenCostFlat ch old.1.val old.2.val (encG z'.1) (encY z'.2) =
      chosenCostInt4 ch (fullGapsOf old z') (fullHeightsOf old z') := by
  rcases ch with _ | ⟨v1, _ | ⟨v2, _ | ⟨v3, rest⟩⟩⟩
  · rfl
  · simp [chosenCostFlat, chosenCostInt4, edgeCostFlat_eq]
  · simp [chosenCostFlat, chosenCostInt4, edgeCostFlat_eq]
  · simp [chosenCostFlat, chosenCostInt4, edgeCostFlat_eq]

def listMinInt {α : Type*} (f : α → ℤ) : (l : List α) → l ≠ [] → ℤ
  | [a], _ => f a
  | a :: b :: rest, _ => min (f a) (listMinInt f (b :: rest) (List.cons_ne_nil _ _))

lemma listMinInt_cast {α : Type*} (f : α → ℤ) :
    ∀ (l : List α) (hl : l ≠ []), (listMinInt f l hl : ℝ) = listMin (fun a => (f a : ℝ)) l hl
  | [_], _ => rfl
  | _ :: b :: rest, _ => by
    simp only [listMinInt, listMin, Int.cast_min]
    rw [listMinInt_cast f (b :: rest) (List.cons_ne_nil _ _)]

/-- Zero-closure minimum over predecessor list (avoids allocating a closure 2.5B times). -/
def dpMinPreds (V : Array ℤ) (zPrev gOld yOld gi yi : ℕ) :
    (l : List (Fin 56 × List (Fin 4))) → l ≠ [] → ℤ
  | [p], _ => V[p.1.val * 82944 + zPrev]! + chosenCostFlat p.2 gOld yOld gi yi
  | p :: q :: rest, _ =>
    min (V[p.1.val * 82944 + zPrev]! + chosenCostFlat p.2 gOld yOld gi yi)
      (dpMinPreds V zPrev gOld yOld gi yi (q :: rest) (List.cons_ne_nil _ _))

lemma dpMinPreds_eq_listMinInt (V : Array ℤ) (zPrev gOld yOld gi yi : ℕ) :
    ∀ (l : List (Fin 56 × List (Fin 4))) (hl : l ≠ []),
      dpMinPreds V zPrev gOld yOld gi yi l hl =
        listMinInt (fun p => V[p.1.val * 82944 + zPrev]! + chosenCostFlat p.2 gOld yOld gi yi) l hl
  | [_], _ => rfl
  | _ :: q :: rest, _ => by
    simp only [dpMinPreds, listMinInt]
    rw [dpMinPreds_eq_listMinInt V zPrev gOld yOld gi yi (q :: rest) (List.cons_ne_nil _ _)]

/-- Zero-allocation inner term for `(gOld, yOld, gi, yi)`. -/
@[inline] def dpTermFast (V : Array ℤ) (u' : Fin 56) (gOld yOld gi yi : ℕ) : ℤ :=
  let zPrev := (gOld * 16 + gi / 4) * 1296 + (yOld * 216 + yi / 6)
  dpMinPreds V zPrev gOld yOld gi yi (preds4 u') (automaton4.preds_ne u')

/-- Zero-allocation explicit sum over `gOld ∈ 0..3`, `yOld ∈ 0..5` (20x faster than `Finset.univ`). -/
@[inline] def dpSumY (V : Array ℤ) (u' : Fin 56) (gOld gi yi : ℕ) : ℤ :=
  dpTermFast V u' gOld 0 gi yi + dpTermFast V u' gOld 1 gi yi +
  dpTermFast V u' gOld 2 gi yi + dpTermFast V u' gOld 3 gi yi +
  dpTermFast V u' gOld 4 gi yi + dpTermFast V u' gOld 5 gi yi

@[inline] def dpSumFast (V : Array ℤ) (u' : Fin 56) (gi yi : ℕ) : ℤ :=
  dpSumY V u' 0 gi yi + dpSumY V u' 1 gi yi +
  dpSumY V u' 2 gi yi + dpSumY V u' 3 gi yi

lemma dpSumFast_eq_sum (V : Array ℤ) (u' : Fin 56) (gi yi : ℕ) :
    dpSumFast V u' gi yi =
      ∑ old : Label 4 6, dpTermFast V u' old.1.val old.2.val gi yi := by
  rw [Fintype.sum_prod_type, Fin.sum_univ_four]
  simp only [Fin.sum_univ_six, dpSumFast, dpSumY]
  rfl

@[inline] private def absDiffNat (a b : ℕ) : ℕ :=
  if a ≤ b then b - a else a - b

@[inline] private def pickC (v : ℕ) (c0 c1 c2 c3 : ℤ) : ℤ :=
  match v with
  | 0 => c0
  | 1 => c1
  | 2 => c2
  | _ => c3

/-- Fast witness generator for `dpPotential4`: hoists `preds4`, `gDiv4/gMod16/gMod4`, `y0..y3`,
and `c1..c4` lookups with zero closure allocations. `checkFixedPoint4_sound` is
independent of how `dpPotential4` is computed. -/
def dpStepArr (V : Array ℤ) : Array ℤ := Id.run do
  let mut NV : Array ℤ := Array.replicate (56 * 82944) 0
  let mut acc6 : Array ℤ := Array.replicate 6 0
  for u in [0:56] do
    if hu : u < 56 then
      let uFin : Fin 56 := ⟨u, hu⟩
      let ps := (preds4 uFin).toArray.map fun p =>
        let baseP := p.1.val * 82944
        match p.2 with
        | [] => (baseP, (0 : ℕ), 0, 0)
        | [v1] => (baseP, 1, v1.val, 0)
        | [v1, v2] => (baseP, 2, v1.val, v2.val)
        | _ => (baseP, 0, 0, 0)
      let nps := ps.size
      let baseU := u * 82944
      for gi in [0:64] do
        let gDiv4 := gi / 4
        let c1Base := (gi % 4) * 6
        let c2Base := (gi % 16) * 6
        let c3Base := gi * 6
        let baseG := baseU + gi * 1296
        for y0 in [0:6] do
          for y1 in [0:6] do
            for y2 in [0:6] do
              let yiDiv6 := (y0 * 6 + y1) * 6 + y2
              let baseYi := baseG + yiDiv6 * 6
              for k in [0:6] do
                acc6 := acc6.set! k 0
              for gOld in [0:4] do
                let c4Base := (gOld * 64 + gi) * 6
                let gPrevBase := (gOld * 16 + gDiv4) * 1296 + yiDiv6
                for yOld in [0:6] do
                  let zPrev := gPrevBase + yOld * 216
                  -- Pre-fetch V for each pred once across all 6 values of y3
                  for y3 in [0:6] do
                    let c0 := costFlat4[c4Base + absDiffNat yOld y3]!
                    let c1 := costFlat3[c3Base + absDiffNat y0 y3]!
                    let c2 := costFlat2[c2Base + absDiffNat y1 y3]!
                    let c3 := costFlat1[c1Base + absDiffNat y2 y3]!
                    let p0 := ps[0]!
                    let mut best := V[p0.1 + zPrev]! +
                      if p0.2.1 == 0 then 0
                      else if p0.2.1 == 1 then pickC p0.2.2.1 c0 c1 c2 c3
                      else pickC p0.2.2.1 c0 c1 c2 c3 + pickC p0.2.2.2 c0 c1 c2 c3
                    for idx in [1:nps] do
                      let pi := ps[idx]!
                      let cand := V[pi.1 + zPrev]! +
                        if pi.2.1 == 0 then 0
                        else if pi.2.1 == 1 then pickC pi.2.2.1 c0 c1 c2 c3
                        else pickC pi.2.2.1 c0 c1 c2 c3 + pickC pi.2.2.2 c0 c1 c2 c3
                      if cand < best then best := cand
                    acc6 := acc6.set! y3 (acc6[y3]! + best)
              for y3 in [0:6] do
                let s := acc6[y3]!
                NV := NV.set! (baseYi + y3) (-((-s) / 24))
  let shift := NV[0]!
  return NV.map (· - shift)

def computedpPotential4 (iters : ℕ) : Array ℤ := Id.run do
  let mut V : Array ℤ := Array.replicate (56 * 82944) 0
  for _ in [0:iters] do
    V := dpStepArr V
  return V

/-- Fast executable fixed-point verifier over all `56 * 64 * 1296 = 4,644,864` states. -/
def checkFixedPoint4 (V : Array ℤ) (uInt : ℤ) : Bool :=
  (List.finRange 56).all fun u' =>
    (List.finRange 64).all fun gi =>
      (List.finRange 1296).all fun yi =>
        decide (dpSumFast V u' gi.val yi.val ≤ 24 * (V[u'.val * 82944 + (gi.val * 1296 + yi.val)]! + uInt))

def dpPotential4 : Array ℤ := computedpPotential4 22

private lemma listMin_div {α : Type*} (f : α → ℝ) {c : ℝ} (hc : 0 ≤ c) :
    ∀ (l : List α) (hl : l ≠ []), listMin f l hl / c = listMin (fun a => f a / c) l hl
  | [_], _ => rfl
  | a :: b :: rest, _ => by
    simp only [listMin]
    rw [← listMin_div f hc (b :: rest) (List.cons_ne_nil _ _)]
    rcases le_total (f a) (listMin f (b :: rest) (List.cons_ne_nil _ _)) with h | h
    · rw [min_eq_left h, min_eq_left (div_le_div_of_nonneg_right h hc)]
    · rw [min_eq_right h, min_eq_right (div_le_div_of_nonneg_right h hc)]

private lemma listMin_congr {α : Type*} {f g : α → ℝ} {l : List α} (hl : l ≠ [])
    (h : ∀ x, f x = g x) : listMin f l hl = listMin g l hl := by
  have : f = g := funext h; subst this; rfl

theorem checkFixedPoint4_sound {V : Array ℤ} {uInt : ℤ}
    (hcheck : checkFixedPoint4 V uInt = true) :
    ∀ (u' : Fin 56) (z' : Window 3 4 6),
      dpOp automaton4 edgeCost4 (fun u z => (V[encUZ u z]! : ℝ) / (costScale : ℝ)) u' z' ≤
        (V[encUZ u' z']! : ℝ) / (costScale : ℝ) + (uInt : ℝ) / (costScale : ℝ) := by
  intro u' z'
  have h1 := List.all_eq_true.mp hcheck u' (List.mem_finRange u')
  have h2 := List.all_eq_true.mp h1 ⟨encG z'.1, encG_lt z'.1⟩ (List.mem_finRange _)
  have h3 := List.all_eq_true.mp h2 ⟨encY z'.2, encY_lt z'.2⟩ (List.mem_finRange _)
  rw [decide_eq_true_eq] at h3
  have hreal : (dpSumFast V u' (encG z'.1) (encY z'.2) : ℝ) ≤
      24 * ((V[encUZ u' z']! : ℝ) + (uInt : ℝ)) := by
    have h3' : (dpSumFast V u' (encG z'.1) (encY z'.2) : ℝ) ≤
        ((24 * (V[u'.val * 82944 + (encG z'.1 * 1296 + encY z'.2)]! + uInt) : ℤ) : ℝ) := by
      exact_mod_cast h3
    simpa [encUZ, encZ] using h3'
  have hsc : (0 : ℝ) < (costScale : ℝ) := by norm_num [costScale]
  have hspec_eq : (dpSumFast V u' (encG z'.1) (encY z'.2) : ℝ) / (costScale : ℝ) =
      ∑ old : Label 4 6,
        listMin (fun p =>
          (V[encUZ p.1 (prevWindow old z')]! : ℝ) / (costScale : ℝ) +
            chosenTableCost edgeCost4 p.2 (fullGapsOf old z') (fullHeightsOf old z'))
          (automaton4.preds u') (automaton4.preds_ne u') := by
    rw [dpSumFast_eq_sum]
    push_cast
    rw [Finset.sum_div]
    apply Finset.sum_congr rfl
    intro old _
    unfold dpTermFast
    rw [dpMinPreds_eq_listMinInt, listMinInt_cast, listMin_div _ (le_of_lt hsc)]
    exact listMin_congr (automaton4.preds_ne u') (fun p => by
      simp only [Int.cast_add, add_div]
      rw [chosenCostFlat_eq, ← chosenCostInt4_cast, encUZ, encZ, encG_prevWindow, encY_prevWindow])
  unfold dpOp
  rw [← hspec_eq]
  have h24 : ((4 * 6 : ℕ) : ℝ) = 24 := by norm_num
  rw [h24, div_le_iff₀ (by norm_num : (0 : ℝ) < 24)]
  have hdiv : (dpSumFast V u' (encG z'.1) (encY z'.2) : ℝ) / (costScale : ℝ) ≤
      24 * ((V[encUZ u' z']! : ℝ) + (uInt : ℝ)) / (costScale : ℝ) := by
    exact div_le_div_of_nonneg_right hreal (le_of_lt hsc)
  have hrhs : 24 * ((V[encUZ u' z']! : ℝ) + (uInt : ℝ)) / (costScale : ℝ) =
      ((V[encUZ u' z']! : ℝ) / (costScale : ℝ) + (uInt : ℝ) / (costScale : ℝ)) * 24 := by ring
  linarith

end BHHBounds.Upper
