private def stepMatch4 (u u' : Fin 56) (ch : List (Fin 4)) : Bool :=
  match stepState (stateOf4 u) ch with
  | none => false
  | some m => (List.finRange 4).all fun i => decide (m i = stateOf4 u' i)

private lemma stepMatch4_sound {u u' : Fin 56} {ch : List (Fin 4)}
    (h : stepMatch4 u u' ch = true) : stepState (stateOf4 u) ch = some (stateOf4 u') := by
  unfold stepMatch4 at h
  cases hs : stepState (stateOf4 u) ch with
  | none => simp [hs] at h
  | some m =>
    simp only [hs, List.all_eq_true, decide_eq_true_eq] at h
    congr 1
    funext i
    exact h i (List.mem_finRange i)

private lemma all_preds_valid4 :
    (List.finRange 56).all (fun u' => (preds4 u').all (fun p => stepMatch4 p.1 u' p.2)) = true := by
  decide

private lemma all_preds_ne4 :
    (List.finRange 56).all (fun u' => !(preds4 u').isEmpty) = true := by
  decide

private lemma all_reach_valid4 :
    (List.finRange 56).all (fun u =>
      let st := reachStatesArr4[u.val]!
      let ch := reachChoicesArr4[u.val]!
      decide (st[0]! = (0 : Fin 56)) &&
      decide (st[4]! = u) &&
      (List.finRange 4).all (fun t => decide ((st[t.val]!, ch[t.val]!) ∈ preds4 (st[t.val + 1]!)))) = true := by
  decide

def automaton4 : AutomatonGraph 3 56 where
  stateOf := stateOf4
  initIdx := 0
  init_eq := by funext i; fin_cases i <;> decide
  preds := preds4
  preds_ne := by
    intro u'
    have h := List.all_eq_true.mp all_preds_ne4 u' (List.mem_finRange u')
    simp at h
    exact h
  preds_valid := by
    intro u' p hp
    have h1 := List.all_eq_true.mp all_preds_valid4 u' (List.mem_finRange u')
    exact stepMatch4_sound (List.all_eq_true.mp h1 p hp)
  reachSteps := 4
  reachWalk := by
    intro u
    have h := List.all_eq_true.mp all_reach_valid4 u (List.mem_finRange u)
    simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
    refine ⟨fun t => (reachStatesArr4[u.val]!)[t.val]!, fun t => (reachChoicesArr4[u.val]!)[t.val]!,
      h.1.1, h.1.2, fun t => h.2 t (List.mem_finRange t)⟩

